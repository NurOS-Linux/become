---
import MainLayout from '../layouts/MainLayout.astro';
import Icon from '../components/Icon.astro';

const formUrl = 'https://tally.so/r/mB6774?transparentBackground=1&dynamicHeight=1';
---

<MainLayout title="Заявка в команду NurOS" description="Форма заявки на вступление в команду NurOS.">
  <script slot="head" is:inline async src="https://tally.so/widgets/embed.js" onload="Tally.loadEmbeds()"></script>
  <section class="apply">
    <div class="container">
      <a href="/" class="btn btn-text back">
        <Icon name="arrow-back" />
        К вакансиям
      </a>
      <h1 class="display-small emphasized">Заявка</h1>
      <div class="form-card">
        <iframe data-tally-src={formUrl} loading="lazy" width="100%" height="600" title="Заявка в команду NurOS"></iframe>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .apply {
    padding: var(--spacing-md) 0 var(--spacing-xl);
  }

  .back {
    margin-bottom: var(--spacing-sm);
    margin-left: -0.75rem;
  }

  h1 {
    margin-bottom: var(--spacing-md);
    letter-spacing: -0.02em;
  }

  .form-card {
    max-width: 48rem;
    padding: var(--spacing-md);
    border-radius: var(--shape-xl-increased);
    background-color: var(--md-surface-container);
  }

  iframe {
    display: block;
    border: 0;
  }

  @media (max-width: 576px) {
    .form-card { padding: var(--spacing-sm); }
  }
</style>
